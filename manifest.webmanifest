    {id:'shuizhu-fish',cn:'水煮鱼',en:'Sichuan chilli-poached fish',region:'Sichuan',meal:['lunch','dinner'],mood:['spicy','hearty'],allergens:['fish','soy','sesame'],diet:['seafood'],dislikes:['very-spicy'],spice:3,homeCook:false,art:'fish',note:'Tender fish in a chilli-forward broth; often very spicy.',recipe:['Cook fish slices gently in seasoned stock.','Add vegetables and a Sichuan-style chilli sauce.','Adjust chilli carefully and serve with rice.']},
    {id:'fish-fragrant-pork',cn:'鱼香肉丝',en:'Sichuan shredded pork',region:'Sichuan',meal:['lunch','dinner'],mood:['spicy','hearty'],allergens:['soy','wheat'],diet:['pork'],dislikes:['very-spicy'],spice:2,homeCook:true,art:'stirfry',note:'Despite the name, this dish usually contains pork rather than fish.',recipe:['Stir-fry shredded pork until cooked.','Add bamboo shoots or peppers and a garlic-vinegar sauce.','Serve with rice.']},
    {id:'dry-pot-cauliflower',cn:'干锅花菜',en:'Dry-pot cauliflower',region:'Hunan / Sichuan-inspired',meal:['lunch','dinner'],mood:['spicy','fresh'],allergens:['soy','wheat'],diet:['vegetarian'],dislikes:['very-spicy'],spice:2,homeCook:true,art:'greens',note:'Crispy-tender cauliflower with savoury, spicy seasoning.',recipe:['Blanch cauliflower briefly, then drain.','Stir-fry with garlic, peppers and a little soy sauce.','Add chilli only to the preferred heat level.']},
    {id:'garlic-greens',cn:'蒜蓉青菜',en:'Garlic leafy greens',region:'Cantonese-style side',meal:['lunch','dinner'],mood:['fresh','lazy'],allergens:['soy'],diet:['vegetarian'],dislikes:['garlic'],spice:0,homeCook:true,art:'greens',note:'A simple vegetable dish to balance a richer meal.',recipe:['Wash and dry leafy greens.','Quickly stir-fry garlic in a little oil.','Add greens and cook until just tender; season lightly.']},
