    {id:'scallion-noodles',cn:'葱油拌面',en:'Scallion oil noodles',region:'Shanghai',meal:['breakfast','lunch','dinner'],mood:['lazy','comfort'],allergens:['wheat','soy'],diet:['vegetarian'],dislikes:['garlic'],spice:0,porkRisk:true,homeCook:true,art:'noodles',note:'Simple noodles with fragrant scallion oil and soy sauce.',recipe:['Cook noodles and drain.','Gently fry chopped scallions in oil until golden.','Toss noodles with scallion oil and a little soy sauce.']},
    {id:'congee',cn:'白粥配小菜',en:'Congee with side dishes',region:'Across China',meal:['breakfast','lunch','dinner'],mood:['comfort','fresh','lazy'],allergens:['soy','sesame'],diet:[],dislikes:[],spice:0,porkRisk:true,homeCook:true,art:'soup',note:'Warm rice porridge with small savoury sides.',recipe:['Simmer rice with plenty of water until creamy.','Season lightly.','Serve with pickled vegetables or greens after checking ingredients.']},
    {id:'baozi-veg',cn:'香菇青菜包',en:'Mushroom and greens bun',region:'Chinese bakery / breakfast',meal:['breakfast','lunch'],mood:['comfort','lazy'],allergens:['wheat','soy'],diet:['vegetarian'],dislikes:['mushroom'],spice:0,homeCook:false,art:'dumpling',note:'A soft steamed bun with a savoury vegetable filling.',recipe:['Use ready-made vegetable buns.','Steam according to the package directions.','Serve hot with tea or soy milk.']},
    {id:'stinky-tofu',cn:'臭豆腐',en:'Stinky tofu',region:'Street-food favourite',meal:['lunch','dinner','snack'],mood:['spicy','surprise'],allergens:['soy','wheat'],diet:['vegetarian'],dislikes:['fermented'],spice:2,homeCook:false,art:'tofu',note:'A famously pungent fermented tofu snack—not for every mood.',recipe:['Pan-fry or deep-fry until crisp.','Serve with chilli sauce and pickled vegetables.','Eat in small bites; the smell is strongest first.']},
    {id:'scallion-pancake',cn:'葱油饼',en:'Scallion pancake',region:'Northern / East China',meal:['breakfast','lunch','snack'],mood:['hearty','lazy'],allergens:['wheat'],diet:['vegetarian'],dislikes:[],spice:0,porkRisk:true,homeCook:true,art:'stirfry',note:'Flaky, savoury and best eaten hot.',recipe:['Pan-fry a frozen scallion pancake with a little oil.','Flip until crisp and fully heated.','Cut into wedges and share.']},
