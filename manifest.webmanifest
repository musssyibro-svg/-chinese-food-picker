      "The next meal's":"下一顿饭的",
      "main character.":"主角登场！",
      "A little spin, a tiny bit of suspense, and one less decision to make.":"转一转，期待一下，今天少做一个决定。",
      "You've filtered the food universe a little too well 😅":"筛选条件太严格啦 😅",
      "There aren't any dishes in this combination yet. Try another meal time, lower the spice limit, or remove one preference. Allergy and dietary restrictions should only be changed when genuinely needed.":"这个组合目前还没有符合条件的菜品。试试换个餐段、降低辣度，或去掉一个偏好。过敏和饮食限制只在必要时调整。",
      "Review my filters":"检查筛选条件",
      "THE FOOD ROULETTE":"美食轮盘",
      "Ready to find something yummy?":"准备好寻找美味了吗？",
      "YOUR NEXT MEAL":"你的下一餐",
      "Spin for my food":"转出我的美食",
      "Spin for our food":"转出我们的一餐",
      "REROLLS":"重新抽选",
      "2 left":"还可抽选 2 次",
      "The universe has spoken ✨":"美食宇宙已给出答案 ✨",
      "This is the one.":"就是它了！",
      "👩‍🍳 Easy version at home":"👩‍🍳 简单家常做法",
      "That's our dinner ♡":"今晚就吃它吧 ♡",
      "♡ Save favourite":"♡ 收藏这道菜",
      "♥ Saved favourite":"♥ 已收藏",
      "↗ Share this dish":"↗ 分享这道菜",
      "↻ Shuffle again":"↻ 再抽一次",
      "No rerolls left":"没有剩余抽选次数",
      "← Change the mood":"← 更换心情",
      "A tiny bit of love, one good meal. This picker is an idea generator, not an ingredient or allergy-safety guarantee. Always check the actual dish and preparation.":"一点心意，一顿好饭。这个选择器只是想法生成器，不是食材或过敏安全保证。最好再确认具体菜品和做法。",
      "Your saved cravings ♡":"你收藏的美食 ♡",
      "Close ✕":"关闭 ✕",
      "Remove":"移除",
      "No saved cravings yet. When a dish looks good, tap “Save favourite” and it will live here.":"还没有收藏过任何美食。当你发现想吃的菜时，点一下“收藏这道菜”，它就会出现在这里。",
      "Person 1 preferences":"第一位用餐者的偏好",
      "Person 2 preferences":"第二位用餐者的偏好",
      "Set both people’s needs; suggestions must work for both.":"设置双方的需求，推荐结果必须同时适合两个人。",
      "For anyone marked as having allergies, select the allergy types first.":"请先为标记有过敏的用餐者选择具体过敏原。",
      "No rerolls left this round. You can start a new round ♡":"本轮没有剩余抽选次数，可以开始新一轮 ♡",
      "This is the only match that fits every filter.":"只有这道菜符合全部条件。",
      "You’ve seen the whole shortlist — duplicates are possible now.":"已经看完所有候选菜品，接下来可能重复。",
      "Saved for another hungry day ♡":"已收藏，留着下次嘴馋时再看 ♡",
      "Removed from your saved cravings.":"已从收藏中移除。",
      "Decision made ✨":"决定好了 ✨",
      "A decision has been made. Victory!":"终于决定吃什么啦！",
      "Copied — ready to send ♡":"已复制，可以分享啦 ♡",
      "Publish the project online first, then this button can share its link.":"请先将项目发布到网上，之后即可分享链接。",
      "Spin for a dish first, then share your pick.":"请先抽选一道菜���再分享你的选择。",
      "Can cook at home":"可以在家做",
      "Breakfast-friendly":"适合早餐",
      "Mild":"清淡",
      "A little kick":"微辣",
      "Spicy":"辣",
      "Very spicy":"特辣",
      "Everyday favourite":"日常人气美食",
      "Northern-style breakfast":"北方风味早餐",
      "Shanghai / East China":"华东 / 上海",
      "idea fits":"个选项符合",
      "ideas fit":"个选项符合",
      "your":"你的",
      " filters.":"筛选条件。",
      "filters":"筛选条件",
      "this could be the one.":"这道也许就是最佳选择。",
      "Ready to find something yummy?":"准备好寻找美味了吗？",
      "A gentle breakfast drink.":"温和清爽的早餐饮品。",
      "Soft, filling and easy to share.":"松软饱腹，适合分享。",
      "Roast meat over rice; check the exact meat and sauce.":"米饭配烧味；请确认具体肉类和酱汁。",
      "Photo credits":"图片来源",
      "Photos from Pexels and Unsplash.":"图片来自 Pexels 和 Unsplash。"
    };
    const FOOD_TRANSLATIONS = {};
    const RECIPE_TRANSLATIONS = {};
    const ZH_EN = Object.fromEntries(Object.entries(EN_ZH).map(([en,zh]) => [zh,en]));
    let currentLanguage = (() => {
      try { return localStorage.getItem(LANGUAGE_KEY) || 'zh'; } catch (_) { return 'zh'; }
    })();
    const escapeRegExp = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    function translateText(value, language) {
      const trimmed = value.trim();
      const lead = value.slice(0, value.indexOf(trimmed));
      const trail = value.slice(value.indexOf(trimmed) + trimmed.length);
      if (language === 'zh') {
        const count = trimmed.match(/^([0-9]+) ideas? fits? your (breakfast|lunch|dinner|snack \/ sweet) filters?\.$/i);
        if (count) {
          const meals = {breakfast:'早餐',lunch:'午餐',dinner:'晚餐','snack / sweet':'小吃 / 甜品'};
          return lead + count[1] + ' 个选项符合你的' + (meals[count[2].toLowerCase()] || '用餐') + '筛选条件。' + trail;
        }
      } else {
        const count = trimmed.match(/^([0-9]+) 个选项符合你的(早餐|午餐|晚餐|小吃 \/ 甜品)筛选条件。$/);
        if (count) {
          const meals = {早餐:'breakfast',午餐:'lunch',晚餐:'dinner','小吃 / 甜品':'snack / sweet'};
          return lead + count[1] + ' idea' + (count[1] === '1' ? '' : 's') + ' fit your ' + meals[count[2]] + ' filters.' + trail;
        }
      }
      const dictionary = language === 'zh' ? EN_ZH : ZH_EN;
      const exact = dictionary[trimmed];
      if (exact !== undefined) return value.replace(value.trim(), exact);
      let output = value;
      const pairs = Object.entries(dictionary).sort((a,b) => b[0].length - a[0].length);
      for (const [source,target] of pairs) {
        if (source.length < 5) continue;
        const re = new RegExp(escapeRegExp(source), 'g');
        output = output.replace(re, target);
      }
      return output;
    }
    const localizationTextState = new WeakMap();
    const localizationAttributeState = new WeakMap();
    function localizePage() {
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      for (const node of nodes) {
        const parent = node.parentElement;
        if (!parent || ['SCRIPT','STYLE'].includes(parent.tagName)) continue;
        let record = localizationTextState.get(node);
        if (!record) {
          record = { source: node.nodeValue, lastOutput: node.nodeValue };
          localizationTextState.set(node, record);
        } else if (node.nodeValue !== record.lastOutput) {
          record.source = node.nodeValue;
        }
        const next = translateText(record.source, currentLanguage);
        if (next !== node.nodeValue) node.nodeValue = next;
        record.lastOutput = next;
      }
      for (const el of document.querySelectorAll('[title],[aria-label],[placeholder],[alt]')) {
        let state = localizationAttributeState.get(el);
        if (!state) { state = {}; localizationAttributeState.set(el, state); }
        for (const attr of ['title','aria-label','placeholder','alt']) {
          if (!el.hasAttribute(attr)) continue;
          let record = state[attr];
          const current = el.getAttribute(attr);
          if (!record) {
            record = { source: current, lastOutput: current };
            state[attr] = record;
          } else if (current !== record.lastOutput) {
            record.source = current;
          }
          const after = translateText(record.source, currentLanguage);
          if (after !== current) el.setAttribute(attr, after);
          record.lastOutput = after;
        }
      }
      const button = document.getElementById('language-toggle');
      if (button) {
        const label = currentLanguage === 'zh' ? 'EN' : '中文';
        const aria = currentLanguage === 'zh' ? '切换到英文' : 'Switch to Chinese';
        if (button.textContent !== label) button.textContent = label;
        if (button.getAttribute('aria-label') !== aria) button.setAttribute('aria-label', aria);
        if (button.title !== aria) button.title = aria;
      }
      document.documentElement.lang = currentLanguage === 'zh' ? 'zh-CN' : 'en';
    }
    function setLanguage(language) {
      currentLanguage = language === 'en' ? 'en' : 'zh';
      try { localStorage.setItem(LANGUAGE_KEY, currentLanguage); } catch (_) {}
      localizePage();
    }
    let localizationQueued = false;
    function scheduleLocalization() {
      if (localizationQueued) return;
      localizationQueued = true;
      queueMicrotask(() => {
        localizationQueued = false;
        localizePage();
      });
    }
    document.addEventListener('click', scheduleLocalization, true);
    document.addEventListener('change', scheduleLocalization, true);
    document.getElementById('language-toggle').addEventListener('click', () => setLanguage(currentLanguage === 'zh' ? 'en' : 'zh'));
    localizePage();
  })();
</script>
</body>
</html>
