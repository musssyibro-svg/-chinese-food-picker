<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#fff8ee" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="description" content="A playful, offline-first Chinese food picker for solo cravings or shared meal decisions." />
  <link rel="manifest" href="./manifest.webmanifest" />
  <title>今晚吃什么？ — What Are We Eating?</title>
  <style>
    :root {
      --ink: #34251f;
      --muted: #84756b;
      --paper: #fff9f0;
      --surface: rgba(255,255,255,.82);
      --line: #eddfd0;
      --coral: #d65f48;
      --coral-dark: #b84d39;
      --peach: #ffe2d4;
      --sage: #dfe9d9;
      --lavender: #ebe4f5;
      --gold: #f3cf79;
      --shadow: 0 16px 48px rgba(98,62,39,.09);
      --radius: 24px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; min-height: 100vh; color: var(--ink);
      background: radial-gradient(circle at 8% 4%, #ffeadc 0, transparent 25rem),
                  radial-gradient(circle at 94% 18%, #e6eddf 0, transparent 28rem),
                  var(--paper);
      font-family: ui-rounded, "SF Pro Rounded", "Avenir Next", Avenir, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input { font: inherit; }
    button { cursor: pointer; -webkit-tap-highlight-color: transparent; }
    button:focus-visible, input:focus-visible { outline: 3px solid #d98d77; outline-offset: 3px; }
    .app-shell { width: min(1080px, 100%); margin: 0 auto; padding: 18px 22px 46px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap: 16px; padding: 8px 0 25px; }
    .brand { display:flex; align-items:center; gap: 12px; min-width: 0; }
    .brand-mark { display:grid; place-items:center; width:46px; height:46px; border-radius:16px; background:#f8d5c4; font-size:25px; box-shadow:inset 0 -3px 0 rgba(175,91,61,.08); }
    .brand-title { font-size:15px; font-weight:900; letter-spacing:.04em; line-height:1.1; }
    .brand-sub { margin-top:4px; font-size:11px; color:var(--muted); letter-spacing:.08em; text-transform:uppercase; }
    .top-actions { display:flex; align-items:center; gap:9px; }
    .offline-pill { display:flex; align-items:center; gap:6px; color:#4f7651; background:#e8f0e2; border:1px solid #d5e3cd; border-radius:999px; padding:9px 12px; font-size:11px; font-weight:800; }
    .offline-dot { width:7px; height:7px; border-radius:50%; background:#6e9a64; }
    .icon-button { display:flex; align-items:center; gap:7px; border:1px solid var(--line); border-radius:999px; padding:10px 13px; background:rgba(255,255,255,.7); color:var(--ink); font-weight:800; }
    .icon-button:hover { background:white; transform:translateY(-1px); }
    .screen { display:none; animation: fade-up .32s ease both; }
    .screen.active { display:block; }
    @keyframes fade-up { from { opacity:0; transform:translateY(8px);} to {opacity:1;transform:translateY(0);} }
    .eyebrow { margin:0 0 10px; color:var(--coral-dark); font-size:11px; font-weight:900; letter-spacing:.15em; text-transform:uppercase; }
    h1 { margin:0; font-size:clamp(35px, 6vw, 58px); line-height:1.02; letter-spacing:-.055em; font-weight:950; }
    h1 .accent { color:var(--coral); }
    .lede { max-width: 600px; margin:15px 0 25px; color:var(--muted); font-size:15px; line-height:1.65; }
    .step-track { display:flex; align-items:center; gap:8px; margin:0 0 25px; }
    .step-dot { height:5px; flex:1; border-radius:99px; background:#eadbca; }
    .step-dot.on { background:var(--coral); }
    .step-caption { margin-left:7px; color:var(--muted); font-size:11px; font-weight:800; white-space:nowrap; }
    .setup-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
    .panel { padding:22px; background:var(--surface); border:1px solid rgba(230,211,191,.84); border-radius:var(--radius); box-shadow:var(--shadow); backdrop-filter:blur(12px); }
    .panel.full { grid-column:1 / -1; }
    .panel-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; margin:0 0 17px; }
    .panel h2 { margin:0; font-size:17px; letter-spacing:-.025em; }
    .panel-desc { margin:5px 0 0; color:var(--muted); font-size:12px; line-height:1.5; }
    .small-counter { flex:none; padding:6px 9px; background:#f8eee2; border-radius:99px; color:#8b6552; font-size:10px; font-weight:850; }
    .choice-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; }
    .choice-card { min-height:88px; display:flex; flex-direction:column; align-items:flex-start; justify-content:space-between; gap:12px; padding:13px 12px; border:1px solid var(--line); background:rgba(255,255,255,.66); border-radius:18px; color:var(--ink); transition:transform .18s ease, border-color .18s ease, background-color .18s ease; }
    .choice-card .emoji { font-size:22px; line-height:1; }
    .choice-card .choice-label { font-size:12px; line-height:1.2; font-weight:850; }
    .choice-card .choice-help { display:block; font-size:10px; font-weight:500; color:var(--muted); margin-top:4px; line-height:1.35; }
    .choice-card:hover { transform:translateY(-2px); border-color:#e0b5a3; }
    .choice-card.selected { border-color:var(--coral); background:#fff0e8; box-shadow:0 0 0 2px rgba(214,95,72,.10); }
    .plan-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; }
    .plan-card { min-height:113px; }
    .people-tabs { display:flex; gap:8px; padding:5px; background:#f7eee5; border-radius:13px; }
    .people-tabs button { flex:1; border:0; border-radius:10px; padding:10px 12px; color:var(--muted); font-weight:850; background:transparent; font-size:12px; }
    .people-tabs button.selected { background:white; color:var(--ink); box-shadow:0 2px 8px rgba(80,50,32,.08); }
    .mode-tabs { margin-bottom:19px; }
    .profile-heading { margin-top:2px; }
    .preference-section { margin-top:19px; }
    .section-label { display:block; margin-bottom:10px; font-size:12px; font-weight:900; }
    .helper-line { font-size:11px; line-height:1.5; color:var(--muted); margin:8px 0 0; }
    .toggle-row { display:flex; justify-content:space-between; gap:12px; align-items:center; padding:12px 13px; background:#fff9f3; border:1px solid var(--line); border-radius:14px; }
    .toggle-row span { font-size:12px; font-weight:800; }
    .toggle-copy { display:flex; flex-direction:column; gap:4px; }
    .toggle-copy strong { font-size:12px; font-weight:900; }
    .toggle-copy small { color:var(--muted); font-size:10px; font-weight:550; line-height:1.45; }
    .switch { position:relative; flex:none; width:42px; height:24px; }
    .switch input { position:absolute; opacity:0; width:1px; height:1px; }
    .switch-track { display:block; width:42px; height:24px; border-radius:20px; background:#d7cabe; transition:.2s; }
    .switch-track:after { content:""; position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; box-shadow:0 1px 3px #0002; transition:.2s; }
    .switch input:checked + .switch-track { background:var(--coral); }
    .switch input:checked + .switch-track:after { transform:translateX(18px); }
    .check-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
    .check-pill { display:flex; align-items:center; gap:9px; min-height:39px; padding:9px 10px; border:1px solid var(--line); border-radius:12px; background:#fffdf9; font-size:11px; color:#55443a; }
    .check-pill input { width:15px; height:15px; margin:0; accent-color:var(--coral); flex:none; }
    .check-pill:has(input:checked) { background:#fff0e8; border-color:#e0aa97; }
    .hidden { display:none !important; }
    .subtle-divider { height:1px; background:var(--line); margin:17px 0; }
    .spice-row { display:flex; gap:7px; }
    .spice-button { flex:1; padding:10px 8px; border:1px solid var(--line); background:#fffdf9; color:var(--muted); border-radius:12px; font-size:11px; font-weight:850; }
    .spice-button.selected { color:#9d452f; border-color:#e2a38b; background:#fff0e8; }
    .allergy-warning { margin-top:12px; padding:11px 12px; border-radius:12px; border:1px solid #f0cfaa; background:#fff5df; color:#7b5a32; font-size:10px; line-height:1.5; }
    .privacy-note { display:flex; gap:9px; align-items:flex-start; padding:12px 14px; margin-top:14px; border-radius:14px; background:#edf3e8; color:#58704e; font-size:11px; line-height:1.45; }
    .footer-actions { display:flex; justify-content:space-between; align-items:center; gap:15px; margin-top:22px; }
    .text-button { padding:11px 2px; border:0; background:transparent; color:var(--muted); font-size:12px; font-weight:800; }
    .text-button:hover { color:var(--coral-dark); }
    .primary-button { display:inline-flex; justify-content:center; align-items:center; gap:10px; padding:15px 20px; min-height:52px; border:0; border-radius:15px; background:var(--coral); color:white; font-size:13px; font-weight:900; box-shadow:0 8px 0 #b74d38; transition:transform .14s ease, box-shadow .14s ease, background .14s ease; }
    .primary-button:hover { background:#c9543d; transform:translateY(-1px); box-shadow:0 8px 0 #b74d38,0 15px 26px rgba(180,77,56,.18); }
    .primary-button:active { transform:translateY(4px); box-shadow:0 3px 0 #b74d38; }
    .primary-button:disabled { opacity:.55; cursor:not-allowed; transform:none; box-shadow:none; }
    .secondary-button { display:inline-flex; justify-content:center; align-items:center; gap:8px; padding:13px 16px; min-height:47px; background:white; color:var(--ink); border:1px solid var(--line); border-radius:15px; font-size:12px; font-weight:800; }
    .secondary-button:hover { background:#fff4eb; border-color:#dfb6a1; }
    .mood-layout { display:grid; grid-template-columns:1fr .72fr; align-items:start; gap:25px; }
    .mood-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:11px; margin-top:22px; }
    .mood-card { display:flex; gap:13px; align-items:center; padding:16px; min-height:86px; border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.82); text-align:left; transition:transform .18s ease, border-color .18s ease, background-color .18s ease; }
    .mood-card:hover { transform:translateY(-2px); }
    .mood-card.selected { background:#fff0e8; border-color:var(--coral); box-shadow:0 0 0 2px rgba(214,95,72,.11); }
    .mood-icon { width:44px; height:44px; flex:none; display:grid; place-items:center; background:var(--peach); border-radius:15px; font-size:23px; }
    .mood-card:nth-child(2) .mood-icon { background:#fde4b8; }
    .mood-card:nth-child(3) .mood-icon { background:var(--sage); }
    .mood-card:nth-child(4) .mood-icon { background:#dff0ee; }
    .mood-card:nth-child(5) .mood-icon { background:var(--lavender); }
    .mood-card:nth-child(6) .mood-icon { background:#f4e2aa; }
    .mood-title { display:block; font-size:13px; font-weight:900; line-height:1.2; }
    .mood-desc { display:block; margin-top:5px; color:var(--muted); font-size:10px; line-height:1.4; }
    .mood-side { padding:24px; background:#f6e6d7; border-radius:26px; position:relative; overflow:hidden; min-height:310px; }
    .mood-side:after { content:"♡"; position:absolute; right:-12px; bottom:-48px; font-family:Georgia,serif; color:rgba(201,101,72,.15); font-size:190px; line-height:1; transform:rotate(-15deg); }
    .mood-side .big-emoji { font-size:60px; margin:8px 0 20px; position:relative; z-index:1; }
    .mood-side h3 { margin:0; font-size:23px; max-width:250px; line-height:1.1; letter-spacing:-.04em; position:relative; z-index:1; }
    .mood-side p { color:#896b5b; font-size:12px; line-height:1.6; max-width:235px; position:relative; z-index:1; }
    .mood-side .little-note { position:relative; z-index:1; display:inline-flex; padding:8px 10px; border-radius:99px; background:rgba(255,255,255,.62); font-size:10px; font-weight:850; color:#8f6c5a; }
    .spin-header { text-align:center; max-width:620px; margin:0 auto 18px; }
    .spin-header .lede { margin:12px auto 0; }
    .spin-stage { position:relative; width:min(620px,100%); margin:24px auto 0; padding:17px; border-radius:30px; background:rgba(255,255,255,.74); border:1px solid #ead8c5; box-shadow:var(--shadow); }
    .stage-ribbon { position:absolute; left:50%; top:-13px; transform:translateX(-50%); z-index:2; padding:7px 13px; border-radius:99px; background:var(--gold); color:#735327; font-size:10px; font-weight:900; letter-spacing:.15em; }
    .spin-card { position:relative; overflow:hidden; border-radius:22px; background:#f4e4d5; }
    .spin-image { display:block; width:100%; height:clamp(220px, 40vw, 350px); object-fit:cover; background:#f1e1cf; transition:opacity .28s ease, filter .28s ease, transform .28s ease; }
    .spin-info { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:16px 18px 19px; background:#fffdf9; transition:opacity .22s ease, filter .22s ease; }
    .spin-card.spinning .spin-image { opacity:.035; filter:blur(14px); transform:scale(1.06); }
    .spin-card.spinning .spin-info { opacity:0; filter:blur(8px); }
    .spin-card.spinning::after { content:"✦"; position:absolute; inset:0; z-index:2; display:grid; place-items:center; color:#bd684f; font-size:clamp(70px,18vw,128px); font-weight:900; background:rgba(255,255,255,.12); }
    .spin-card.revealing .spin-image { animation:food-reveal .42s ease both; }
    @keyframes mystery-pulse { from { opacity:.78; transform:scale(.985); } to { opacity:1; transform:scale(1.015); } }
    @keyframes food-reveal { from { opacity:0; filter:blur(12px); transform:scale(1.045); } to { opacity:1; filter:blur(0); transform:scale(1); } }
    @media (prefers-reduced-motion: reduce) { .spin-card.spinning::after { animation:none; } .spin-image,.spin-info { transition:none; } .spin-card.revealing .spin-image { animation:none; } }
    .spin-name-cn { font-size:25px; line-height:1.1; font-weight:950; letter-spacing:-.04em; }
    .spin-name-en { margin-top:5px; font-size:12px; color:var(--muted); font-weight:700; }
    .spin-region { display:inline-flex; max-width:140px; padding:7px 10px; background:#f6eee3; border-radius:99px; text-align:center; font-size:9px; font-weight:850; color:#8e715b; line-height:1.3; }
    .slot-spark { position:absolute; font-size:25px; pointer-events:none; }
    .spark-a { left:-9px; top:82px; color:#d68e6c; transform:rotate(-15deg); }
    .spark-b { right:-8px; top:175px; color:#89a47c; transform:rotate(14deg); }
    .spin-controls { display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:11px; margin:21px auto 0; }
    .reroll-pill { display:flex; align-items:center; gap:7px; padding:9px 11px; border:1px solid var(--line); border-radius:99px; background:#fffdf9; font-size:10px; font-weight:900; color:var(--muted); }
    .reroll-dots { display:flex; gap:4px; }
    .reroll-dot { width:7px; height:7px; border-radius:50%; background:var(--coral); }
    .reroll-dot.used { background:#ded1c5; }
    .result-detail { display:none; text-align:center; margin:20px auto 0; max-width:620px; animation:fade-up .35s ease both; }
    .result-detail.visible { display:block; }
    .result-kicker { display:inline-block; padding:7px 11px; background:#e6efdf; color:#58744e; border-radius:99px; font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.1em; }
    .result-detail h2 { margin:10px 0 7px; font-size:26px; letter-spacing:-.04em; }
    .result-detail p { max-width:500px; margin:0 auto; color:var(--muted); font-size:12px; line-height:1.6; }
    .dish-tags { display:flex; justify-content:center; gap:7px; flex-wrap:wrap; margin:13px 0 0; }
    .dish-tag { background:#f5e9db; color:#846b55; border-radius:99px; padding:6px 9px; font-size:10px; font-weight:850; }
    .cook-recipe { margin:16px auto 0; max-width:500px; padding:15px 17px; border-radius:16px; background:#f0f3e9; text-align:left; }
    .cook-recipe strong { display:block; margin-bottom:8px; font-size:12px; }
    .cook-recipe ol { margin:0; padding-left:19px; color:#627257; font-size:11px; line-height:1.65; }
    .result-buttons { display:flex; gap:9px; justify-content:center; flex-wrap:wrap; margin-top:17px; }
    .done-message { display:none; margin:17px auto 0; max-width:440px; padding:14px 15px; border-radius:14px; background:#fff0e8; color:#874734; font-size:12px; font-weight:850; line-height:1.5; }
    .done-message.visible { display:block; }
    .back-link { display:inline-flex; gap:7px; align-items:center; margin:19px auto 0; border:0; background:none; color:var(--muted); font-size:11px; font-weight:850; }
    .filter-count { margin-top:12px; color:var(--muted); font-size:11px; text-align:center; }
    .empty-state { margin:16px auto; padding:22px; max-width:560px; background:#fff5df; border:1px solid #f0d7ac; border-radius:18px; color:#785b36; font-size:12px; line-height:1.6; text-align:left; }
    .empty-state strong { display:block; font-size:14px; margin-bottom:6px; }
    .empty-state button { margin-top:11px; }
    dialog { width:min(600px,calc(100% - 26px)); max-height:84vh; border:1px solid var(--line); border-radius:24px; padding:0; background:var(--paper); color:var(--ink); box-shadow:0 24px 80px rgba(53,38,31,.25); }
    dialog::backdrop { background:rgba(49,34,29,.38); backdrop-filter:blur(4px); }
    .dialog-head { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:19px 22px; border-bottom:1px solid var(--line); }
    .dialog-head h2 { margin:0; font-size:19px; }
    .dialog-body { padding:16px 22px 22px; overflow:auto; }
    .favorite-row { display:flex; align-items:center; gap:13px; padding:10px 0; border-bottom:1px solid var(--line); }
    .favorite-row:last-child { border-bottom:0; }
    .favorite-row img { width:75px; height:60px; object-fit:cover; border-radius:12px; }
    .favorite-main { min-width:0; flex:1; }
    .favorite-main strong { display:block; font-size:13px; }
    .favorite-main span { display:block; margin-top:4px; font-size:11px; color:var(--muted); }
    .remove-fav { border:1px solid var(--line); background:white; border-radius:10px; padding:7px 9px; font-size:10px; font-weight:850; color:#9e5744; }
    .no-favs { text-align:center; color:var(--muted); padding:30px 10px; font-size:12px; line-height:1.6; }
    .toast { position:fixed; left:50%; bottom:23px; transform:translate(-50%,20px); max-width:calc(100% - 28px); padding:12px 16px; border-radius:13px; color:white; background:#382b25; font-size:12px; font-weight:800; opacity:0; transition:opacity .22s ease, transform .22s ease; }
    .toast.show { opacity:1; transform:translate(-50%,0); }
    .tiny-foot { margin:28px auto 0; max-width:560px; text-align:center; color:#9a897c; font-size:10px; line-height:1.6; }
    .tiny-foot strong { color:#826b5b; }
    @media (max-width:760px) {
      .app-shell { padding:12px 14px 35px; }
      .topbar { padding-bottom:20px; }
      .offline-pill { padding:8px 10px; font-size:0; gap:0; }
      .offline-dot { width:8px; height:8px; }
      .icon-button { padding:9px 10px; }
      #share-app span { display:none; }
      .setup-grid { grid-template-columns:1fr; }
      .panel.full { grid-column:auto; }
      .panel { padding:18px; border-radius:21px; }
      .choice-grid { grid-template-columns:repeat(2,1fr); }
      .choice-card { min-height:78px; }
      .plan-grid { grid-template-columns:repeat(2,1fr); }
      .plan-card { min-height:88px; }
      .mood-layout { grid-template-columns:1fr; gap:17px; }
      .mood-grid { margin-top:17px; }
      .mood-side { min-height:auto; display:grid; grid-template-columns:65px 1fr; column-gap:15px; padding:19px; align-items:center; }
      .mood-side .big-emoji { font-size:46px; grid-row:span 2; margin:0; }
      .mood-side h3 { font-size:19px; }
      .mood-side p { grid-column:1 / -1; margin:10px 0; max-width:100%; }
      .mood-side .little-note { grid-column:1 / -1; justify-self:start; }
      .footer-actions { align-items:flex-end; }
      .footer-actions .primary-button { flex:1; }
      .spin-stage { padding:10px; margin-top:23px; }
      .spin-image { height:245px; }
      .spin-name-cn { font-size:22px; }
    }
    @media (max-width:420px) {
      .brand-title { font-size:13px; }
      .brand-sub { font-size:9px; }
      .brand-mark { width:40px; height:40px; border-radius:14px; }
      h1 { font-size:37px; }
      .lede { font-size:13px; }
      .mood-card { padding:11px; gap:9px; min-height:79px; }
      .mood-icon { width:37px; height:37px; border-radius:13px; font-size:20px; }
      .mood-title { font-size:12px; }
      .mood-desc { font-size:9px; }
      .spin-info { padding:13px; }
      .spin-name-cn { font-size:20px; }
      .spin-region { font-size:8px; padding:6px 8px; }
      .result-buttons button { flex:1 1 42%; }
      .primary-button { padding:14px 14px; }
    }

    .language-button { min-width: 48px; justify-content:center; font-weight:950; border-color:#dfc8b7; background:#fff8f0; }
    .photo-credit { display:block; margin-top:8px; }
    .spin-image, .favorite-row img { background:#f1e1cf; }

    @media (prefers-reduced-motion: reduce) { *, *:before, *:after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; } }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">🥢</div>
        <div>
          <div class="brand-title">今晚吃什么？</div>
          <div class="brand-sub">what are we eating?</div>
        </div>
      </div>
      <div class="top-actions">
        <button class="icon-button language-button" id="language-toggle" type="button" aria-label="Switch language">EN</button>
        <div class="offline-pill" title="The app and food photos are cached for offline use after the first visit"><span class="offline-dot"></span> Works offline</div>
        <button class="icon-button" id="share-app" type="button" aria-label="Share this food picker">↗ <span>Share app</span></button>
        <button class="icon-button" id="open-favorites" type="button" aria-label="Open favorite dishes">♡ <span id="favorite-count">0</span></button>
      </div>
    </header>

    <section class="screen active" id="screen-setup" aria-labelledby="setup-title">
      <div class="step-track"><span class="step-dot on"></span><span class="step-dot"></span><span class="step-dot"></span><span class="step-caption">01 / MAKE IT YOURS</span></div>
      <p class="eyebrow">A little food picker for whoever's hungry</p>
      <h1 id="setup-title">So... what sounds<br><span class="accent">delicious?</span></h1>
      <p class="lede">Choose your meal, set the preferences that matter, and let the food roulette handle the hardest question of the day.</p>

      <div class="setup-grid">
        <div class="panel">
          <div class="panel-heading"><div><h2>First, what time is it?</h2><p class="panel-desc">We'll only suggest food that fits the moment.</p></div></div>
          <div class="choice-grid" id="meal-options">
            <button class="choice-card" data-meal="breakfast" type="button"><span class="emoji">🍳</span><span class="choice-label">Breakfast</span></button>
            <button class="choice-card" data-meal="lunch" type="button"><span class="emoji">🍱</span><span class="choice-label">Lunch</span></button>
            <button class="choice-card selected" data-meal="dinner" type="button"><span class="emoji">🍲</span><span class="choice-label">Dinner</span></button>
            <button class="choice-card" data-meal="snack" type="button"><span class="emoji">🧋</span><span class="choice-label">Snack / sweet</span></button>
          </div>
          <div class="subtle-divider"></div>
          <div class="panel-heading"><div><h2>How do you want to eat?</h2><p class="panel-desc">Cooking stays off the menu unless you invite it.</p></div></div>
          <div class="plan-grid" id="plan-options">
            <button class="choice-card plan-card selected" type="button" data-plan="takeout"><span class="emoji">🛵</span><span class="choice-label">Takeaway<span class="choice-help">Default lazy mode</span></span></button>
            <button class="choice-card plan-card" type="button" data-plan="restaurant"><span class="emoji">🏮</span><span class="choice-label">Eat out<span class="choice-help">Let's go somewhere</span></span></button>
            <button class="choice-card plan-card" type="button" data-plan="maybe-cook"><span class="emoji">🧑‍🍳</span><span class="choice-label">Maybe cook<span class="choice-help">Only if you feel like it</span></span></button>
            <button class="choice-card plan-card" type="button" data-plan="cook"><span class="emoji">🍳</span><span class="choice-label">Let's cook<span class="choice-help">Show easy home recipes</span></span></button>
          </div>
        </div>

        <div class="panel">
          <div class="panel-heading"><div><h2>Who's eating?</h2><p class="panel-desc">Use the picker by yourself or combine preferences for two people.</p></div><span class="small-counter">SAVED HERE</span></div>
          <div class="people-tabs mode-tabs" id="mode-options" role="group" aria-label="Choose who the food picker is for">
            <button type="button" data-mode="solo" class="selected" aria-pressed="true">🙋 Just me</button>
            <button type="button" data-mode="together" aria-pressed="false">🥢 Two people</button>
          </div>
          <div class="panel-heading profile-heading"><div><h2 id="profile-heading">Your preferences</h2><p class="panel-desc" id="profile-desc">Only your preferences will shape the food suggestions.</p></div></div>
          <div class="people-tabs profile-tabs hidden" role="tablist" aria-label="Choose whose preferences to edit">
            <button type="button" data-person="me" class="selected" role="tab" aria-selected="true">🙋 Person 1</button>
            <button type="button" data-person="partner" role="tab" aria-selected="false">🧑 Person 2</button>
          </div>
          <div class="preference-section">
            <div class="toggle-row"><span>Does this person have food allergies?</span><label class="switch"><input type="checkbox" id="allergy-toggle" aria-label="This person has allergies"><i class="switch-track"></i></label></div>
            <div id="allergy-options" class="preference-section hidden">
              <span class="section-label">Select any known allergies</span>
              <div class="check-grid" id="allergy-checks">
                <label class="check-pill"><input type="checkbox" value="peanut"> Peanuts</label>
                <label class="check-pill"><input type="checkbox" value="tree-nut"> Tree nuts</label>
                <label class="check-pill"><input type="checkbox" value="sesame"> Sesame</label>
                <label class="check-pill"><input type="checkbox" value="soy"> Soy / soya</label>
                <label class="check-pill"><input type="checkbox" value="wheat"> Wheat / gluten</label>
                <label class="check-pill"><input type="checkbox" value="dairy"> Milk / dairy</label>
                <label class="check-pill"><input type="checkbox" value="egg"> Egg</label>
                <label class="check-pill"><input type="checkbox" value="fish"> Fish</label>
                <label class="check-pill"><input type="checkbox" value="crustacean"> Shrimp / crab</label>
                <label class="check-pill"><input type="checkbox" value="mollusc"> Clams / squid</label>
              </div>
              <div class="allergy-warning"><strong>Important:</strong> This hides dishes with tagged or common possible allergens. Recipes vary, and unlisted ingredients or cross-contact are possible. Always confirm with the restaurant or cook, especially for allergy-sensitive eaters.</div>
            </div>
          </div>
          <div class="preference-section">
            <span class="section-label">Quick food filter</span>
            <div class="toggle-row pork-free-row">
              <span class="toggle-copy"><strong>🥢 Pork-free dishes only</strong><small>Hide dishes known to contain pork or commonly prepared with pork.</small></span>
              <label class="switch"><input type="checkbox" id="pork-free-toggle" aria-label="Only show pork-free dishes"><i class="switch-track"></i></label>
            </div>
            <p class="helper-line">Saved privately on this device. Switch it off any time. Broths, sauces, oils and restaurant preparation can vary, so confirm ingredients when needed.</p>
          </div>
          <div class="preference-section">
            <span class="section-label">Anything else you don't eat?</span>
            <div class="check-grid" id="diet-checks">
              <label class="check-pill"><input type="checkbox" value="beef"> Avoid beef</label>
              <label class="check-pill"><input type="checkbox" value="lamb"> Avoid lamb</label>
              <label class="check-pill"><input type="checkbox" value="seafood"> Avoid seafood</label>
              <label class="check-pill"><input type="checkbox" value="vegetarian"> Vegetarian</label>
            </div>
          </div>
          <div class="preference-section">
            <span class="section-label">How much spice can you handle?</span>
            <div class="spice-row" id="spice-options">
              <button class="spice-button" data-spice="0" type="button">🥛 Mild</button>
              <button class="spice-button selected" data-spice="2" type="button">🌶️ Medium</button>
              <button class="spice-button" data-spice="3" type="button">🔥 Hot is fine</button>
            </div>
          </div>
          <div class="preference-section">
            <span class="section-label">Foods you'd rather skip</span>
            <div class="check-grid" id="dislike-checks">
              <label class="check-pill"><input type="checkbox" value="cilantro"> Cilantro / 香菜</label>
              <label class="check-pill"><input type="checkbox" value="fermented"> Fermented / stinky food</label>
              <label class="check-pill"><input type="checkbox" value="mushroom"> Mushrooms</label>
              <label class="check-pill"><input type="checkbox" value="garlic"> Garlic</label>
              <label class="check-pill"><input type="checkbox" value="onion"> Onion / scallion</label>
              <label class="check-pill"><input type="checkbox" value="very-sweet"> Very sweet food</label>
              <label class="check-pill"><input type="checkbox" value="offal"> Organs / offal</label>
              <label class="check-pill"><input type="checkbox" value="bitter-melon"> Bitter melon</label>
            </div>
          </div>
          <div class="privacy-note"><span>🔒</span><span>Your preferences and favourites stay in this browser on this device. Nothing syncs to other phones, so anyone you share the app with gets their own private setup.</span></div>
        </div>
      </div>
      <div class="footer-actions">
        <button class="text-button" id="reset-settings" type="button">Reset preferences</button>
        <button class="primary-button" id="to-mood" type="button">Next: pick a mood <span>→</span></button>
      </div>
    </section>

    <section class="screen" id="screen-mood" aria-labelledby="mood-title">
      <div class="step-track"><span class="step-dot on"></span><span class="step-dot on"></span><span class="step-dot"></span><span class="step-caption">02 / PICK A VIBE</span></div>
      <div class="mood-layout">
        <div>
          <p class="eyebrow">No overthinking allowed</p>
          <h1 id="mood-title">What's the<br><span class="accent">vibe today?</span></h1>
          <p class="lede">Just tap the mood that feels closest. It's a nudge, not a rule. The food still has to pass your filters.</p>
          <div class="mood-grid" id="mood-options">
            <button class="mood-card" type="button" data-mood="comfort"><span class="mood-icon">🫶</span><span><span class="mood-title">Comfort me</span><span class="mood-desc">Warm, cosy, familiar</span></span></button>
            <button class="mood-card" type="button" data-mood="spicy"><span class="mood-icon">🌶️</span><span><span class="mood-title">Spicy chaos</span><span class="mood-desc">Bring on some excitement</span></span></button>
            <button class="mood-card" type="button" data-mood="fresh"><span class="mood-icon">🍃</span><span><span class="mood-title">Fresh &amp; light</span><span class="mood-desc">Something not too heavy</span></span></button>
            <button class="mood-card" type="button" data-mood="hearty"><span class="mood-icon">🍚</span><span><span class="mood-title">Properly hungry</span><span class="mood-desc">I need a proper meal</span></span></button>
            <button class="mood-card" type="button" data-mood="lazy"><span class="mood-icon">🛋️</span><span><span class="mood-title">Lazy mode</span><span class="mood-desc">Easy, no extra effort</span></span></button>
            <button class="mood-card" type="button" data-mood="sweet"><span class="mood-icon">🍓</span><span><span class="mood-title">Treat myself</span><span class="mood-desc">A little dessert energy</span></span></button>
            <button class="mood-card" type="button" data-mood="surprise"><span class="mood-icon">🎲</span><span><span class="mood-title">Surprise me</span><span class="mood-desc">Let the food universe decide</span></span></button>
          </div>
          <div class="footer-actions"><button class="text-button" id="back-setup" type="button">← Back to preferences</button><button class="primary-button" id="to-spin" type="button">Let's play <span>→</span></button></div>
        </div>
        <aside class="mood-side"><div class="big-emoji" id="mood-side-emoji">💌</div><h3 id="mood-side-title">One hungry person.<br>One delicious answer.</h3><p id="mood-side-copy">No more scrolling. No more debating. Just one good idea with a few filters in the way.</p><div class="little-note" id="mood-side-note">MADE FOR YOUR NEXT CRAVING ♡</div></aside>
      </div>
    </section>

    <section class="screen" id="screen-spin" aria-labelledby="spin-title">
      <div class="step-track"><span class="step-dot on"></span><span class="step-dot on"></span><span class="step-dot on"></span><span class="step-caption">03 / LET FATE DECIDE</span></div>
      <div class="spin-header">
        <p class="eyebrow">Drumroll, please</p>
        <h1 id="spin-title">The next meal's <span class="accent">main character.</span></h1>
        <p class="lede" id="spin-subtitle">A little spin, a tiny bit of suspense, and one less decision to make.</p>
      </div>
      <div id="empty-pool" class="empty-state hidden"><strong>You've filtered the food universe a little too well 😅</strong>There aren't any dishes in this combination yet. Try another meal time, lower the spice limit, or remove one preference. Allergy and dietary restrictions should only be changed when genuinely needed.</div>
      <div id="roulette-area">
        <div class="spin-stage">
          <span class="stage-ribbon">THE FOOD ROULETTE</span><span class="slot-spark spark-a">✦</span><span class="slot-spark spark-b">✿</span>
          <div class="spin-card" id="spin-card">
            <img id="spin-image" class="spin-image" src="data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%22440%22%20height%3D%22320%22%20viewBox%3D%220%200%20440%20320%22%3E%3Crect%20width%3D%22440%22%20height%3D%22320%22%20fill%3D%22%23f1e1cf%22/%3E%3C/svg%3E" alt="Food preview" />
            <div class="spin-info"><div><div id="spin-name-cn" class="spin-name-cn">准备好了吗？</div><div id="spin-name-en" class="spin-name-en">Ready to find something yummy?</div></div><span class="spin-region">YOUR NEXT MEAL</span></div>
          </div>
        </div>
        <div class="spin-controls">
          <button class="primary-button" id="spin-button" type="button">Spin for our food <span>🎲</span></button>
          <div class="reroll-pill" id="reroll-counter"><span>REROLLS</span><span class="reroll-dots"><i class="reroll-dot"></i><i class="reroll-dot"></i></span><span>2 left</span></div>
        </div>
        <div class="filter-count" id="filter-count"></div>
        <div class="result-detail" id="result-detail" aria-live="polite">
          <span class="result-kicker">The universe has spoken ✨</span>
          <h2 id="result-title">This is the one.</h2>
          <p id="result-note"></p>
          <div class="dish-tags" id="dish-tags"></div>
          <div class="cook-recipe hidden" id="cook-recipe"><strong>👩‍🍳 Easy version at home</strong><ol id="recipe-steps"></ol></div>
          <div class="result-buttons">
            <button class="primary-button" id="accept-pick" type="button">That's our dinner ♡</button>
            <button class="secondary-button" id="save-favorite" type="button">♡ Save favourite</button>
            <button class="secondary-button" id="share-pick" type="button">↗ Share this dish</button>
            <button class="secondary-button" id="reroll-button" type="button">↻ Shuffle again</button>
          </div>
          <div class="done-message" id="done-message"></div>
        </div>
      </div>
      <button class="back-link" id="back-mood" type="button">← Change the mood</button>
    </section>

    <p class="tiny-foot"><strong>一点点爱，一顿好饭。</strong> A tiny bit of love, one good meal. This picker is an idea generator, not an ingredient or allergy-safety guarantee. Always check the actual dish and preparation.</p>
  </div>

  <dialog id="favorites-dialog" aria-labelledby="favorites-title">
    <div class="dialog-head"><h2 id="favorites-title">Your saved cravings ♡</h2><button class="icon-button" id="close-favorites" type="button">Close ✕</button></div>
    <div class="dialog-body" id="favorites-list"></div>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./service-worker.js').catch(() => {});
    });
  }

  window.FOOD_DATABASE = [
    {id:'baozi',cn:'包子',en:'Steamed buns',region:'Everyday favourite',meal:['breakfast','lunch'],mood:['comfort','lazy','hearty'],allergens:['wheat','soy'],diet:['pork'],dislikes:[],spice:0,homeCook:true,art:'dumpling',note:'Soft, filling and easy to share.',recipe:['Buy frozen buns or prepare ready-made buns.','Steam for 8–12 minutes until hot throughout.','Serve with soy milk or a simple soup.']},
    {id:'soy-milk',cn:'豆浆',en:'Soy milk',region:'Northern-style breakfast',meal:['breakfast','snack'],mood:['fresh','lazy','sweet'],allergens:['soy'],diet:[],dislikes:[],spice:0,homeCook:true,art:'drink',note:'A gentle breakfast drink.',recipe:['Use unsweetened or sweetened soy milk.','Warm gently or serve chilled.','Pair with buns or youtiao.']},
    {id:'youtiao',cn:'油条',en:'Chinese fried dough sticks',region:'Northern-style breakfast',meal:['breakfast'],mood:['hearty','lazy'],allergens:['wheat'],diet:[],dislikes:[],spice:0,homeCook:false,art:'stirfry',note:'Crispy outside, fluffy inside.',recipe:['Deep-fry or air-fry until puffed and golden.','Serve hot with soy milk or congee.','Eat with a little sweetened condensed milk if you like.']},
    {id:'jianbing',cn:'煎饼果子',en:'Jianbing breakfast crepe',region:'Tianjin',meal:['breakfast','lunch'],mood:['hearty','lazy'],allergens:['wheat','egg','soy','sesame'],diet:[],dislikes:[],spice:0,porkRisk:true,homeCook:false,art:'stirfry',note:'A savoury crepe folded around crunchy fillings.',recipe:['Spread a thin wheat batter in a hot pan.','Add an egg, sauce and crunchy cracker or youtiao.','Fold with spring onion and optional cilantro.']},
    {id:'tea-egg',cn:'茶叶蛋',en:'Tea eggs',region:'Everyday snack',meal:['breakfast','snack'],mood:['comfort','lazy'],allergens:['egg','soy'],diet:[],dislikes:[],spice:0,homeCook:true,art:'egg',note:'A savoury, aromatic grab-and-go snack.',recipe:['Hard-boil eggs, then gently crack the shells.','Simmer in tea, soy sauce and warm spices.','Let them steep for deeper flavour.']},
    {id:'wonton',cn:'馄饨汤',en:'Wonton soup',region:'Southern China',meal:['breakfast','lunch','dinner'],mood:['comfort','fresh'],allergens:['wheat','soy','egg'],diet:['pork'],dislikes:[],spice:0,homeCook:false,art:'soup',note:'Comforting dumplings in a light broth.',recipe:['Bring a light stock to a boil.','Cook wontons according to the packet instructions.','Add leafy greens and spring onion.']},
    {id:'xiaolongbao',cn:'小笼包',en:'Soup dumplings',region:'Jiangnan / Shanghai',meal:['breakfast','lunch'],mood:['comfort','hearty'],allergens:['wheat','soy'],diet:['pork'],dislikes:[],spice:0,homeCook:false,art:'dumpling',note:'Juicy little dumplings; let them cool before eating.',recipe:['Place frozen soup dumplings in a lined steamer.','Steam according to the package instructions.','Lift carefully and let cool before taking a bite.']},
    {id:'beef-noodles',cn:'牛肉面',en:'Beef noodle soup',region:'Lanzhou / Northwest',meal:['lunch','dinner'],mood:['comfort','hearty'],allergens:['wheat','soy'],diet:['beef'],dislikes:[],spice:1,homeCook:false,art:'noodles',note:'A warming bowl with noodles, beef and broth.',recipe:['Cook wheat noodles separately.','Warm beef broth and cooked beef slices.','Combine and top with scallion; add chilli to taste.']},
    {id:'huangmenji',cn:'黄焖鸡米饭',en:'Braised chicken with rice',region:'Shandong-style chain favourite',meal:['lunch','dinner'],mood:['comfort','hearty'],allergens:['soy','wheat'],diet:[],dislikes:[],spice:1,homeCook:false,art:'rice',note:'Saucy chicken over rice; a dependable meal-box choice.',recipe:['Sear chicken pieces with ginger.','Simmer with soy sauce, mushrooms and peppers until cooked.','Serve the chicken and sauce over hot rice.']},
    {id:'kung-pao',cn:'宫保鸡丁',en:'Kung Pao chicken',region:'Sichuan',meal:['lunch','dinner'],mood:['spicy','hearty'],allergens:['peanut','soy','wheat'],diet:[],dislikes:[],spice:2,homeCook:true,art:'stirfry',note:'A sweet-savoury Sichuan classic, often with peanuts.',recipe:['Stir-fry diced chicken until nearly cooked.','Add dried chilli, vegetables and a soy-vinegar sauce.','Add roasted peanuts only if safe, then serve with rice.']},
    {id:'tomato-egg',cn:'番茄炒蛋盖饭',en:'Tomato and egg rice bowl',region:'Home-style Chinese',meal:['lunch','dinner'],mood:['comfort','fresh','lazy'],allergens:['egg','soy'],diet:['vegetarian'],dislikes:[],spice:0,homeCook:true,art:'rice',note:'Soft eggs and bright tomato sauce over rice.',recipe:['Scramble eggs until just set and set aside.','Cook chopped tomatoes with a little salt until saucy.','Return eggs to the pan and serve over rice.']},
    {id:'mapo-tofu',cn:'麻婆豆腐',en:'Mapo tofu',region:'Sichuan',meal:['lunch','dinner'],mood:['spicy','hearty'],allergens:['soy','wheat'],diet:['pork'],dislikes:['very-spicy'],spice:3,homeCook:true,art:'tofu',note:'Silky tofu in a bold, spicy bean sauce; meat varies by recipe.',recipe:['Gently simmer tofu cubes in a spicy bean sauce.','Add minced meat or mushrooms if desired.','Thicken lightly and serve with rice.']},
    {id:'hotpot',cn:'火锅',en:'Chinese hot pot',region:'Shared meal',meal:['lunch','dinner'],mood:['spicy','comfort','hearty'],allergens:['soy','sesame','peanut','fish','crustacean','mollusc'],diet:[],dislikes:[],spice:2,homeCook:false,art:'soup',note:'A fun meal to share; broth and dipping sauces vary widely.',recipe:['Prepare a broth suitable for everyone.','Set out sliced vegetables, tofu, noodles and chosen proteins.','Cook each ingredient fully in the simmering broth.']},
    {id:'malatang',cn:'麻辣烫',en:'Malatang spicy soup',region:'Sichuan / street-food favourite',meal:['lunch','dinner'],mood:['spicy','lazy','hearty'],allergens:['soy','sesame','peanut','fish','crustacean'],diet:[],dislikes:[],spice:3,homeCook:false,art:'soup',note:'Choose-your-own ingredients in a spicy or mild broth.',recipe:['Pick your ingredients and heat the broth.','Cook until tender and season to taste.','Add a chilli oil finish if your spice level allows.']},
    {id:'chongqing-noodles',cn:'重庆小面',en:'Chongqing noodles',region:'Chongqing',meal:['breakfast','lunch','dinner'],mood:['spicy','lazy','hearty'],allergens:['wheat','soy','sesame'],diet:[],dislikes:[],spice:3,porkRisk:true,homeCook:false,art:'noodles',note:'A punchy chilli-oil noodle bowl; ask for less spice if needed.',recipe:['Cook alkaline noodles and drain well.','Toss with sesame paste, soy sauce and a little hot water.','Top with pickled vegetables and scallion.']},
    {id:'hot-dry-noodles',cn:'热干面',en:'Wuhan hot dry noodles',region:'Wuhan / Hubei',meal:['breakfast','lunch'],mood:['hearty','lazy'],allergens:['wheat','sesame','soy'],diet:[],dislikes:['cilantro'],spice:1,homeCook:false,art:'noodles',note:'Chewy noodles coated in sesame sauce.',recipe:['Cook wheat noodles and drain.','Mix soy sauce, vinegar, sesame paste and chilli oil to taste.','Toss noodles in the sauce and add scallions.']},
    {id:'liangpi',cn:'凉皮',en:'Cold skin noodles',region:'Shaanxi',meal:['lunch','dinner'],mood:['fresh','spicy'],allergens:['wheat','sesame','soy'],diet:['vegetarian'],dislikes:['cilantro','very-spicy'],spice:2,homeCook:false,art:'noodles',note:'Cool, chewy noodles with a tangy chilli-sesame dressing.',recipe:['Slice chilled liangpi noodles.','Mix vinegar, soy, sesame paste and chilli to taste.','Add cucumber strips and optional cilantro.']},
    {id:'roujiamo',cn:'肉夹馍',en:'Chinese meat burger',region:'Shaanxi',meal:['breakfast','lunch','dinner'],mood:['hearty','lazy'],allergens:['wheat','soy'],diet:['pork'],dislikes:[],spice:0,homeCook:false,art:'stirfry',note:'Crisp flatbread filled with savoury chopped braised meat; meat type varies.',recipe:['Prepare braised meat filling and warm buns.','Stuff into a toasted flatbread.','Serve with pickles or chilli sauce if desired.']},
